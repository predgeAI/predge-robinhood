# Robinhood Chain TESTNET · chainId 46630 · native gas token ETH
# Faucet: https://faucet.testnet.chain.robinhood.com
ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com/rpc
ROBINHOOD_CHAINID=46630
ROBINHOOD_EXPLORER=https://explorer.testnet.chain.robinhood.com
# Filled by `npm run genwallet` — never commit .env
PRIVATE_KEY=
DEPLOYER_ADDRESS=
# The provider party for script/live-loop.mjs. Leave it blank and the loop derives the
# provider key from PRIVATE_KEY: the run still works, but one person controls client,
# provider and validator, so the bond proves nothing about an independent provider.
# Set it to a key nobody else derives and the three parties are genuinely separate.
# Generate one with `npm run genwallet` in a scratch directory and copy the key across.
# It needs no prefunding — the loop sends it exactly the gas its submit costs.
PROVIDER_PRIVATE_KEY=

# Optional overrides:
# NETWORK=rh-testnet      # rh-testnet | rh-mainnet | arbitrum-one | celo-mainnet
# RPC_URL=                # mainnet RPC; defaults to the endpoint baked into lib/robinhood.mjs
# VALIDATOR_ADDRESS=      # defaults to DEPLOYER_ADDRESS
# BOND_DISPUTE_WINDOW=1   # seconds
